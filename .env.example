# ── App ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# openssl rand -base64 32
AUTH_SECRET=

# ── Neon (Postgres) ──────────────────────────────────
# Connection string "pooled" do painel do Neon
DATABASE_URL=

# ── Stripe (cartão + assinatura) ─────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Mercado Pago (Pix) ───────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
# "Assinatura secreta" da página de Webhooks da sua aplicação
MERCADOPAGO_WEBHOOK_SECRET=

# ── Dados da empresa (aparecem nos Termos e na Privacidade) ──
NEXT_PUBLIC_COMPANY_NAME=
# Pessoa física: preencha CPF (e o seu nome em COMPANY_NAME). Pessoa jurídica: preencha CNPJ.
NEXT_PUBLIC_COMPANY_CPF=
NEXT_PUBLIC_COMPANY_CNPJ=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_FORUM_CITY=
# Opcional: nome do encarregado (DPO)
NEXT_PUBLIC_DPO_NAME=

# ── E-mail (Resend): recuperação de senha ────────────
RESEND_API_KEY=
# Ex.: AprovaSync <nao-responda@seudominio.com.br> (domínio verificado no Resend)
EMAIL_FROM=

# ── Limite de tentativas (Upstash Redis) ─────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Monitoramento (Sentry) ───────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Modo beta (OPCIONAL) ─────────────────────────────
# Deixe COMENTADO para COBRAR normalmente. true = acesso gratuito, sem preços nem pagamentos.
# NEXT_PUBLIC_BETA_MODE=true
